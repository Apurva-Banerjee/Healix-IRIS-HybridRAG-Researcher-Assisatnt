# Project Environment Configuration

# OpenAlex API (optional polite pool email)
OPENALEX_API_KEY=
OPENALEX_EMAIL=researcher@example.com

# Semantic Scholar API (optional)
SEMANTIC_SCHOLAR_API_KEY=

# Vector Database (Qdrant)
# If QDRANT_URL is empty, embedded on-disk storage is used at ./storage/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=research_chunks

# Embedding Configuration
# Options: BAAI/bge-m3, BAAI/bge-small-en-v1.5, all-MiniLM-L6-v2, or fast-dense
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# LLM Generation (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Application Ports
API_PORT=8000
API_HOST=127.0.0.1
